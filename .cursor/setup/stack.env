# Shared configuration for the LibreChat Cloud Agent dev stack.
# Sourced by install.sh and start.sh. Values are non-secret dev defaults.

# Container images (mirror docker-compose.yml / rag.yml)
MONGO_IMAGE="mongo:7"
MEILI_IMAGE="getmeili/meilisearch:v1.12.3"
VECTORDB_IMAGE="ankane/pgvector:latest"
RAG_IMAGE="ghcr.io/danny-avila/librechat-rag-api-dev:latest"

# Meilisearch (dev master key; must match .env MEILI_MASTER_KEY)
MEILI_MASTER_KEY="DrhYf7zENyR6AlUCKmnz0eYASOQdl6zxH7s7MKFSfFCt"

# pgvector / Postgres
PG_DB="mydatabase"
PG_USER="myuser"
PG_PASSWORD="mypassword"

# RAG API embeddings. Local HuggingFace model keeps the dev environment
# key-free (production may instead use OpenAI/Azure embeddings via env vars).
RAG_EMBEDDINGS_PROVIDER="huggingface"
RAG_EMBEDDINGS_MODEL="sentence-transformers/all-MiniLM-L6-v2"
RAG_PORT="8000"
